# ET-L1 — toolchain determinism.
#
# save-exact:    `npm i <pkg>` writes "1.2.3", never "^1.2.3". Combined with the
#                committed lockfile this makes two installs a week apart produce
#                the same tree.
# engine-strict: makes the `engines` field in package.json BINDING for every npm
#                command in this project (not just a warning). Node 24 LTS + npm
#                >= 12 are therefore enforced locally and in CI (Round 7 must
#                `npm i -g npm@12` — Node 24 ships npm 11 and would fail here).
#
# NOTE (deliberate divergence from the roadmap): `min-release-age` is NOT set.
# The roadmap proposed min-release-age=3 as a supply-chain quarantine, but the
# standing instruction is that every dependency is pinned to the latest
# published version — a release-age floor directly refuses those versions. The
# trade-off accepted here is: no automatic quarantine window on freshly
# published versions. If that delay is wanted back, add `min-release-age=3` and
# accept that upgrades lag the registry by three days.
save-exact=true
engine-strict=true
