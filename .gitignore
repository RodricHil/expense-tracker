# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated from pinned OCR/PDF dependencies before dev/build
/public/receipt-assets/core/
/public/receipt-assets/worker.min.js
/public/receipt-assets/pdf.worker.min.mjs
/public/receipt-assets/standard_fonts/
/public/receipt-assets/pdf-wasm/
