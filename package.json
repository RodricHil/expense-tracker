{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Expense tracker built with Next.js, MongoDB and NextAuth: Google sign-in, per-user expense CRUD over serverless API routes, and a date-filtered analytics dashboard.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RodricHil/expense-tracker.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "predev": "node scripts/prepare-receipt-assets.mjs",
    "prebuild": "node scripts/prepare-receipt-assets.mjs"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "framer-motion": "14.6.0",
    "mongoose": "9.11.3",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
